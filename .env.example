# Reference only. Export these values in the process environment; .env is not auto-loaded.
NODE_ENV=production
PORT=4173
# Leave DATABASE_URL unset for local SQLite, or provide the Supabase transaction-pooler URL.
DATABASE_URL=
SESSION_SECRET=
# In Vercel, use the exact deployed origin, e.g. https://rehabita-demo.vercel.app
APP_ORIGIN=
# Required in Vercel so express-session recognizes its HTTPS proxy.
TRUST_PROXY=1
