# Reference only. Export these values in the process environment; .env is not auto-loaded.
NODE_ENV=production
PORT=4173
DATABASE_PATH=.data/rehabita.sqlite
SESSION_SECRET=
# In the API host, set the exact public Vercel origin, e.g. https://rehabita-demo.vercel.app
APP_ORIGIN=
# Set TRUST_PROXY=1 only when HTTPS terminates at a trusted reverse proxy.
# TRUST_PROXY=1
